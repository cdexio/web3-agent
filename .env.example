# ZetrynAI engine secrets. Copy to .env and fill in. Never commit .env.
# List-valued keys are comma-separated; the engine rotates them round-robin
# with automatic failover (owner rule 8). One key per provider is enough to start.

# --- runtime -----------------------------------------------------------------
# paper | live | backtest  (paper is the default and the only safe value)
ZETRYN_MODE=paper
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- database ----------------------------------------------------------------
# PostgreSQL connection string of the owner's existing instance.
DATABASE_URL=postgres://user:password@host:5432/zetrynai

# --- Solana RPC / streams (free tiers) ---------------------------------------
# Helius (https://dashboard.helius.dev) - reserved for getTransaction, DAS, Sender.
HELIUS_API_KEYS=
# Alchemy (https://dashboard.alchemy.com) - primary WebSocket stream provider.
ALCHEMY_API_KEYS=
# Optional extra public/other RPC HTTP URLs (comma-separated). Public mainnet is always appended.
EXTRA_RPC_HTTP_URLS=
EXTRA_RPC_WS_URLS=

# --- market data (free tiers) ------------------------------------------------
# RugCheck API keys from FluxRPC (https://fluxrpc.com). Optional: anonymous works at 10 reports/min.
RUGCHECK_API_KEYS=
# Jupiter Swap V2 API keys (https://portal.jup.ag). Optional: api.jup.ag answers quotes without a key.
JUPITER_API_KEYS=
# PumpPortal data API key (https://pumpportal.fun). Optional: the data WebSocket works without one.
PUMPPORTAL_API_KEYS=

# --- AI ----------------------------------------------------------------------
# DeepSeek (https://platform.deepseek.com) - fallback scorer.
DEEPSEEK_API_KEY=
# Claude Code CLI binary and the session to resume (Claude Max subscription login, never an API key).
CLAUDE_BIN=claude
CLAUDE_SESSION_NAME=

# --- live trading only (leave empty in paper mode) ---------------------------
# Absolute path to the hot wallet keypair JSON (outside the repo, chmod 600).
WALLET_KEYPAIR_PATH=
